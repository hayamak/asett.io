---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="お問い合わせ | asett"
  description="asettへのお問い合わせはこちらから。"
>
  <main class="contact">
    <svg aria-hidden="true" class="contact-grid">
      <defs>
        <pattern
          x="50%"
          y="-1"
          id="contact-grid"
          width="200"
          height="200"
          patternUnits="userSpaceOnUse"
        >
          <path d="M.5 200V.5H200" fill="none"></path>
        </pattern>
      </defs>

      <rect
        fill="url(#contact-grid)"
        width="100%"
        height="100%"
        stroke-width="0"
      ></rect>
    </svg>

    <div class="contact-content">
      <div>
        <h1>お問い合わせ</h1>
        <p>入力欄は全てご入力ください。</p>
      </div>

      <ContactForm />
    </div>
  </main>
</Layout>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 6rem 1.5rem;
    background-color: var(--background);
  }

  .contact-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    stroke: var(--border);
    pointer-events: none;
    mask-image: radial-gradient(70% 70% at 50% 0%, white, transparent);
  }

  .contact-content {
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .contact h1 {
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .contact p {
    margin: 0.5rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .contact {
      padding-block: 8rem;
    }

    .contact h1 {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .contact {
      padding-inline: 2rem;
    }
  }
</style>
