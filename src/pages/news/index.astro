---
// src/pages/news/index.astro
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { categoryLabels } from "../../lib/news";

const news = await getCollection("news");

news.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="お知らせ | asett" description="asettからのお知らせです。">
  <main class="news">
    <h1 class="news__title">お知らせ</h1>
    <ul class="news__list">
      {news.map((article) => (
        <li class="news__item">
          <a class="news__link" href={`/news/${article.id}`}>
            <time
              class="news__date"
              datetime={article.data.date.toISOString().slice(0, 10)}
            >
              {article.data.date.toLocaleDateString("ja-JP")}
            </time>
            <span class="news__category">
              {categoryLabels[article.data.category]}
            </span>
            <span class="news__article-title">{article.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .news {
    max-width: 64rem;
    margin-inline: auto;
    padding: 6rem 1.5rem;
  }

  .news__title {
    margin-bottom: 3rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .news__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .news__item {
    border-bottom: 1px solid var(--border);
  }

  .news__link {
    display: grid;
    grid-template-columns: 7rem 8rem minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    color: inherit;
    text-decoration: none;
  }

  .news__date {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .news__category {
    justify-self: start;
    padding: 0.25rem 0.75rem;
    background-color: var(--muted);
    color: var(--muted-foreground);
    border-radius: 0.5rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .news__article-title {
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .news__link:hover .news__article-title {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .news__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (min-width: 40rem) {
    .news {
      padding-block: 8rem;
    }
  }

  @media (max-width: 39.999rem) {
    .news__link {
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      row-gap: 0.75rem;
    }

    .news__article-title {
      grid-column: 1 / -1;
    }
  }
</style>
