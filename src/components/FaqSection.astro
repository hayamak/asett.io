---
// src/components/FaqSection.astro

const faqs = [
  {
    id: 1,
    question: "どのようなIT機器を管理できますか？",
    answer:
      "パソコン、スマートフォン、プリンター、ネットワーク機器など、組織で利用するさまざまなIT機器を管理できます。",
  },
  {
    id: 2,
    question: "購入した機器だけでなく、リース機器も管理できますか？",
    answer:
      "はい。購入したIT機器だけでなく、リースで利用しているIT機器も管理できます。",
  },
  {
    id: 3,
    question: "CSVファイルから一括で登録できますか？",
    answer:
      "はい。CSVファイルを使って複数のIT機器をまとめて登録できます。また、アセットで管理しているデータをCSVファイルとして出力することもできます。",
  },
  {
    id: 4,
    question: "IT機器の貸出や返却も管理できますか？",
    answer: "はい。IT機器の貸出・返却を記録し、機器の利用状況を管理できます。",
  },
  {
    id: 5,
    question: "無料プランでもクレジットカードの登録は必要ですか？",
    answer:
      "いいえ。無料プランのご利用にクレジットカードの登録は必要ありません。",
  },
  {
    id: 6,
    question: "初期データの登録をサポートしてもらえますか？",
    answer:
      "はい。スタンダードプランとプラスプランでは、初回のデータ登録を無料でサポートします。",
  },
  {
    id: 7,
    question: "支払い方法を教えてください。",
    answer:
      "有料プランのお支払いはクレジットカードのみ対応しています。請求書払いには対応していません。",
  },
  {
    id: 8,
    question: "最低利用期間はありますか？",
    answer: "最低利用期間はありません。必要な期間だけご利用いただけます。",
  },
  {
    id: 9,
    question: "利用途中でプランを変更できますか？",
    answer: "はい。ご利用状況に合わせてプランを変更できます。",
  },
];
---

<section id="faq" class="faq">
  <div class="faq__container">
    <h2 class="faq__title">よくあるご質問</h2>

    <p class="faq__intro">
      ご不明な点などは、
      <a href="/contact" class="faq__contact">
        お問い合わせ
      </a>
      からお気軽にご連絡ください。
    </p>

    <dl class="faq__list">
      {faqs.map((faq) => (
        <div class="faq__item">
          <dt class="faq__question">{faq.question}</dt>
          <dd class="faq__answer">{faq.answer}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .faq {
    background: var(--background);
  }

  .faq__container {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 1.5rem;
  }

  .faq__title {
    margin: 0;
    color: var(--foreground);
    font-size: 2.25rem;
    line-height: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .faq__intro {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .faq__contact {
    color: var(--foreground);
    font-weight: 600;
  }

  .faq__contact:hover {
    text-decoration: underline;
  }

  .faq__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin: 5rem 0 0;
  }

  .faq__question {
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.75rem;
    font-weight: 600;
  }

  .faq__answer {
    margin: 0.5rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  @media (min-width: 40rem) {
    .faq__container {
      padding-block: 6rem;
    }

    .faq__title {
      font-size: 3rem;
      line-height: 1;
    }

    .faq__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
      row-gap: 4rem;
    }
  }

  @media (min-width: 64rem) {
    .faq__container {
      padding-inline: 2rem;
    }

    .faq__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
</style>
