---
// src/components/Header.astro

import Logo from "./Logo.astro"

const navigation = [
  { name: "機能", href: "/#features" },
  { name: "料金", href: "/#pricing" },
  { name: "導入事例", href: "/#case-studies" },
];
---

<header class="header">
  <nav class="nav" aria-label="Global">
    <div class="nav__brand">
      <a href="/" class="nav__logo">
        <span class="sr-only">asett.io</span>
        <Logo class="logo" />
      </a>
    </div>

    <div class="nav__links">
      {
        navigation.map((item) => (
          <a href={item.href} class="nav__link">
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="nav__login">
      <a href="/login">
        ログイン <span aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .header {
    background: var(--background);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 80rem;
    margin-inline: auto;
    padding: 1.5rem;
  }

  .nav__brand {
    display: flex;
    flex: 1;
  }

  .nav__logo {
    margin: -0.375rem;
    padding: 0.375rem;
  }

  .nav__links {
    display: flex;
    gap: 3rem;
  }

  .nav__link {
    color: var(--foreground);
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .nav__login {
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .nav__login a {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .nav__login a:hover {
    color: var(--foreground);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 64rem) {
    .nav {
      padding-inline: 2rem;
    }
  }
</style>
