---
// src/components/HeroSection.astro
---

<section class="hero">
  <div class="hero__container">
    <div class="hero__content">
      <div class="hero__announcement">
        <a href="#" class="announcement">
          <span class="announcement__badge">New</span>

          <span class="announcement__message">
            <span>アセットをリリース 🎉</span>

            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="announcement__icon"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </span>
        </a>
      </div>

      <h1 class="hero__title">
        シンプルなIT資産管理
      </h1>

      <p class="hero__description">
        アセットは、組織のIT資産を管理するためのサービスです。必要な機能をシンプルなUIで提供し、無料で今すぐ使い始めることができます。
      </p>

      <div class="hero__actions">
        <a href="/signup" class="button">
          無料ではじめる
        </a>

        <a href="#features" class="hero__features-link">
          機能を見る <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__visual-inner">
        <div class="hero__screenshot-frame">
          <img
            src="https://tailwindcss.com/plus-assets/img/component-images/project-app-screenshot.png"
            alt="App screenshot"
            width="2432"
            height="1442"
            class="hero__screenshot"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }

  .hero__container {
    max-width: 80rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 6rem;
  }

  .hero__content {
    max-width: 42rem;
    margin-inline: auto;
  }

  .hero__announcement {
    margin-top: 6rem;
  }

  .announcement {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
  }

.announcement__badge {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 9999px;
  padding: 0.25rem 0.625rem;
  background: var(--muted);
  color: var(--foreground);
  font-size: 0.75rem;
  line-height: 1rem;
  font-weight: 500;
  white-space: nowrap;
}
  .announcement__message {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 500;
  }

  .announcement__icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .hero__title {
    margin: 2.5rem 0 0;
    color: var(--foreground);
    font-size: 3rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .hero__description {
    margin: 2rem 0 0;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius);
    background: var(--foreground);
    color: var(--background);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
  }

  .button:hover {
    opacity: 0.9;
  }

  .hero__features-link {
    color: var(--foreground);
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .hero__features-link:hover {
    color: var(--muted-foreground);
  }

  .hero__visual {
    display: flex;
    max-width: 42rem;
    margin: 4rem auto 0;
  }

  .hero__visual-inner {
    flex: none;
    max-width: 48rem;
  }

  .hero__screenshot-frame {
    margin: -0.5rem;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: rgb(17 24 39 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(17 24 39 / 0.1);
  }

  .hero__screenshot {
    display: block;
    width: 76rem;
    height: auto;
    max-width: none;
    border-radius: 0.375rem;
    background: #f9fafb;
    box-shadow:
      0 20px 25px -5px rgb(0 0 0 / 0.1),
      0 8px 10px -6px rgb(0 0 0 / 0.1),
      0 0 0 1px rgb(17 24 39 / 0.1);
  }

  @media (min-width: 40rem) {
    .hero__container {
      padding-bottom: 8rem;
    }

    .hero__announcement {
      margin-top: 8rem;
    }

    .hero__title {
      font-size: 3.75rem;
    }

    .hero__description {
      font-size: 1.25rem;
      line-height: 2rem;
    }

    .hero__visual {
      margin-top: 6rem;
    }

    .hero__visual-inner {
      max-width: 64rem;
    }
  }

  @media (min-width: 64rem) {
    .hero__container {
      display: flex;
      padding: 10rem 2rem;
    }

    .hero__content {
      flex-shrink: 0;
      margin-inline: 0;
      padding-top: 2rem;
    }

    .hero__announcement {
      margin-top: 4rem;
    }

    .hero__visual {
      flex: none;
      max-width: none;
      margin-top: 0;
      margin-right: 0;
      margin-left: 2.5rem;
    }

    .hero__visual-inner {
      max-width: none;
    }

    .hero__screenshot-frame {
      margin: -1rem;
      padding: 1rem;
      border-radius: 1rem;
    }
  }

  @media (min-width: 80rem) {
    .hero__visual {
      margin-left: 8rem;
    }
  }
</style>
