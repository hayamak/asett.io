---
// src/layouts/Layout.astro

import "../styles/global.css";
import Header from "../components/Header.astro"

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "アセット | asett",
  description = "シンプルなIT資産管理ツール",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
	<Header />
    <slot />
  </body>
</html>
